# DeepSeek API (set the key in your local .env file; do not commit it)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Local application state (SQLite). Keep the encryption key stable across restarts/backups.
SQLITE_PATH=/data/minsheng-governance.db
APP_ENCRYPTION_KEY=
MIGRATE_LEGACY_GOVERNANCE=true

# Optional external source database on minsheng_default; leave blank for SQLite-only mode
DATABASE_URL=

# Optional GeoServer
GEOSERVER_URL=
GEOSERVER_USER=
GEOSERVER_PASSWORD=
TIANDITU_TK=

# Internal application services
REDIS_URL=redis://redis:6379/0
APP_ENV=development


# true only when reusing an existing Docker network containing your PostgreSQL/GeoServer containers
MINSHENG_NETWORK_NAME=minsheng_default
MINSHENG_NETWORK_EXTERNAL=false
